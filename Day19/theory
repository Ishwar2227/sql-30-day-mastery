You'll build a proper e-commerce database with realistic data volumes. This replaces your practice tables with something closer to production scale.
Step 1 — Create the Schema
Run this in pgAdmin to create a new database called `ecommerce_project`:

sql

```sql
-- Create tables
CREATE TABLE dim_customers (
    customer_id SERIAL PRIMARY KEY,
    customer_name VARCHAR(100),
    email VARCHAR(100),
    city VARCHAR(50),
    state VARCHAR(50),
    age INT,
    gender VARCHAR(10),
    signup_date DATE,
    is_active BOOLEAN DEFAULT TRUE
);

CREATE TABLE dim_products (
    product_id SERIAL PRIMARY KEY,
    product_name VARCHAR(100),
    category VARCHAR(50),
    subcategory VARCHAR(50),
    price NUMERIC(10,2),
    cost NUMERIC(10,2)
);

CREATE TABLE fact_orders (
    order_id SERIAL PRIMARY KEY,
    customer_id INT REFERENCES dim_customers(customer_id),
    order_date DATE,
    delivery_date DATE,
    status VARCHAR(20),
    payment_method VARCHAR(20),
    city VARCHAR(50),
    state VARCHAR(50)
);

CREATE TABLE fact_order_items (
    item_id SERIAL PRIMARY KEY,
    order_id INT REFERENCES fact_orders(order_id),
    product_id INT REFERENCES dim_products(product_id),
    quantity INT,
    unit_price NUMERIC(10,2),
    discount_pct NUMERIC(5,2) DEFAULT 0
);
```

